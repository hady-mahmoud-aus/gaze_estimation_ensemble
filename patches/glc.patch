+def shuffle_dataset(loader, cur_epoch):
+    """
+    Shuffles the data.
+    Args:
+        loader (loader): data loader to perform shuffle.
+        cur_epoch (int): number of the current epoch.
+    """
+    if (
+        loader._dataset_kind
