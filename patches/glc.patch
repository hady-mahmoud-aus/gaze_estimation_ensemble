+        else:
+            if clear_name_pattern:
+                for item in clear_name_pattern:
+                    model_state_dict_new = OrderedDict()
+                    for k in checkpoint["model_state"]:
+                        if item in k:
+                            k_re = k.replace(item, "")
+                            model_state_dict_new[k_re] = checkpoint["model_state"][k]
+                            logger.info("renaming: {} -> {}".format(k, k_re))
