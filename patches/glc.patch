+                # if self.cfg.TEST.NUM_SPATIAL_CROPS > 1
+                # else [self.cfg.DATA.TRAIN_JITTER_SCALES[0]] * 2 + [self.cfg.DATA.TEST_CROP_SIZE]
+            )  # = (256, 256, 256)
