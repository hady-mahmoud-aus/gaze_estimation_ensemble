-        Perform forwarding, gathering the stats across different process/ GPU
-        group.
-        """
-        ctx.num_sync_devices = num_sync_devices
-        ctx.num_groups = num_groups
-
-        input_list = [
-            torch.zeros_like(input) for k in range(du.get_local_size())
