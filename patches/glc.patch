+    categories = []
+    list_of_ids_already_added = []
+    if not label_map:
+        label_id_offset = 1
+        for class_id in range(max_num_classes):
+            categories.append(
+                {
+                    "id": class_id + label_id_offset,
+                    "name": "category_{}".format(class_id + label_id_offset),
