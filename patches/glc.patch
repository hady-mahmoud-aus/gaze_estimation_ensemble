-            rank = du.get_local_rank()
-            group_idx = rank // ctx.num_sync_devices
-            grads = grads[
-                group_idx
-                * ctx.num_sync_devices : (group_idx + 1)
-                * ctx.num_sync_devices
-            ]
-        grads = torch.sum(grads, dim=0)
-        return grads, None, None
