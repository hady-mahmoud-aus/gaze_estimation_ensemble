+def attention_pool(tensor, pool, thw_shape, has_cls_embed=True,
+                   has_global_embed=False, global_embed_num=1, norm=None):
+    if pool is None:
+        return tensor, thw_shape
+    tensor_dim = tensor.ndim
+    if tensor_dim == 4:
