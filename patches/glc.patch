+            ]
+            # Fine-tuning phase.
+            cfg.SOLVER.LRS = cfg.SOLVER.LRS[:-1] + [
+                cfg.SOLVER.LRS[-2],
+                cfg.SOLVER.LRS[-1],
+            ]
+
+            cfg.SOLVER.MAX_EPOCH = self.schedule[-1][-1]
+
+        elif cfg.MULTIGRID.SHORT_CYCLE:
+            cfg.SOLVER.STEPS = [
+                int(s * cfg.MULTIGRID.EPOCH_FACTOR) for s in cfg.SOLVER.STEPS
+            ]
