+def torchvision_decode(
+    video_handle,
+    sampling_rate,
+    num_frames,
+    clip_idx,
+    video_meta,
+    num_clips=10,
+    target_fps=30,
+    modalities=("visual",),
+    max_spatial_scale=0,
+    use_offset=False,
