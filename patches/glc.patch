-        inputs = torch.stack(input_list, dim=0)
-        if num_groups > 1:
-            rank = du.get_local_rank()
-            group_idx = rank // num_sync_devices
-            inputs = inputs[
-                group_idx
-                * num_sync_devices : (group_idx + 1)
