+    def forward(self, x):
+        # print('input', x.shape)
+        
+        y3 = self.base1(x)
+        # print('base1', y3.shape)
+        
+        y = self.maxp2(y3)
+        # print('maxp2', y.shape)
+
+        y2 = self.base2(y)
+        # print('base2', y2.shape)
+
+        y = self.maxp3(y2)
+        # print('maxp3', y.shape)
+
+        y1 = self.base3(y)
+        # print('base3', y1.shape)
+
+        y = self.maxt4(y1)
+        # print('maxt4', y.shape)
+
+        y, i0 = self.maxp4(y)
+        # print('maxp4', y.shape)
+        # print('i0', i0.shape)
+
+        y0 = self.base4(y)
+        # print('base4', y0.shape)
+
+
+        z = self.convtsp1(y0)
+        # print('convtsp1', z.shape)
+        
+        z = self.convtsp2(z)
+        # print('convtsp2', z.shape)
+        
+        z = self.convtsp3(z)
+        # print('convtsp3', z.shape)
+        
+        z = self.convtsp4(z)
+        # print('convtsp4', z.shape)
+        
+        z = z.view(z.size(0), z.size(3), z.size(4))
