+    time_taken = (time.time()-tic)/60
+
+    print('[{:2d}, val] avg_loss : {:.5f} cc_loss : {:.5f} sim_loss : {:.5f}, time : {:3f}'.format(epoch, total_loss.avg, total_cc_loss.avg, total_sim_loss.avg, time_taken))
+    sys.stdout.flush()
+
+    # return total_loss.avg
+
+    data_to_log = {
