+            nn.BatchNorm3d(64, eps=1e-3, momentum=0.001, affine=True),
+            nn.ReLU(),
+
+            nn.Conv3d(64, 64, kernel_size=(2,1,1), stride=(2,1,1), bias=False),
+            nn.BatchNorm3d(64, eps=1e-3, momentum=0.001, affine=True),
+            nn.ReLU(),
