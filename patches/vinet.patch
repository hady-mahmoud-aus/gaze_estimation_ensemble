+        z = self.convtsp1(y0)
+        # print('convtsp1', z.shape)
+        
+        z = self.convtsp2(z)
+        # print('convtsp2', z.shape)
+        
+        z = self.convtsp3(z)
+        # print('convtsp3', z.shape)
+        
+        z = self.convtsp4(z)
+        # print('convtsp4', z.shape)
+        
+        z = z.view(z.size(0), z.size(3), z.size(4))
+        # print('output', z.shape)
+
+        return z
