+		print("Taking the split file: ", file_name)
+		
+		self.list_indata = []
+		with open(join(args.fold_lists_path, file_name), 'r') as f:
+			for line in f.readlines():
+				name = line.split(' ')[0].strip()
+
+				self.list_indata.append(name)
+
+
